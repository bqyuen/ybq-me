# Cloudflare Pages _headers
# 安全头 + 缓存策略（部署自动复制到 public/_headers）
# 参考：https://developers.cloudflare.com/pages/configuration/headers/

# ============= 全站基础安全头 =============
/
  # 防 MIME 嗅探（已有，重复声明保证 100% 命中）
  X-Content-Type-Options: nosniff
  # 防点击劫持 - 允许同源 iframe（ai-assistant 内嵌面板）
  X-Frame-Options: SAMEORIGIN
  # 限制 referrer 泄漏
  Referrer-Policy: strict-origin-when-cross-origin
  # 内容安全策略 - 允许自有域、Cloudflare Workers、giscus
  # script-src 'unsafe-inline' 因 PaperMod 内联 JS（主题切换、阅读进度、AI 助手等）
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app https://*.giscus.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://ybq-me-ai.garyyuen.workers.dev https://*.workers.dev; frame-src https://giscus.app https://*.giscus.com; base-uri 'self'; form-action 'self'
  # 限制浏览器特性
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # 强制 HTTPS
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# ============= 静态资源：长缓存 =============
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ============= 列表页：短缓存 =============
/sitemap.xml
  Cache-Control: public, max-age=3600

/index.xml
  Cache-Control: public, max-age=3600

/index.json
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400

# ============= API：禁用缓存 =============
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  X-Content-Type-Options: nosniff
